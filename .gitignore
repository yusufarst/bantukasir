# Environment files and secrets: never committed (AGENTS rule 9, SEC-SECRET-01).
.env
.env.*
!.env.example
auth.json
*.pem
*.key
*.p12
*.pfx

# Local tool folders: never staged (EXECUTION_CONTEXT EXC-30).
.local/
.agents/

# Dependencies.
/vendor/
/node_modules/

# Build output.
/public/build/
/public/hot
/public/storage
*.tsbuildinfo

# Test output and coverage.
/.phpunit.cache/
.phpunit.result.cache
/coverage/
/playwright-report/
/test-results/
/blob-report/

# Logs, local data dumps and operational data: never in the public repository
# (D-076, SEC-SECRET-01). private/ and data/ are anchored to the root, so that
# Laravel's placeholders in storage/ stay tracked.
*.log
*.sqlite
*.dump
*.backup
secrets/
backups/
uploads/
/private/
/data/

# Operating systems and editors.
.DS_Store
Thumbs.db
.idea/
.vscode/
