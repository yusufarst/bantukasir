<?xml version="1.0" encoding="UTF-8"?>
<!--
    PHPUnit (TEST_STRATEGY section 2): L1 in tests/Unit (composer test:unit),
    which needs no network; L2 and L4 on real PostgreSQL in tests/Feature
    (composer test:postgres); L3 in tests/Concurrency (composer test:race). The
    suite Network, tests/Network, holds the negative proofs of the dependency
    audit that need Packagist's advisories; composer lint runs it after the
    audit itself. A test is never retried until it passes (TS-08).

    CI runs the suite Postgres as its two parts, each in its own job on its
    own runner and test database (D-120): Postgres1 (composer
    test:postgres:1) is tests/Feature without the directories that Postgres2
    (composer test:postgres:2) names, so that a new directory joins
    Postgres1. scripts/checks/postgres-parts.sh proves with PHPUnit's own
    list that together they hold every test of Postgres once; locally,
    composer test:postgres stays the whole suite. To balance the parts, a
    directory moves from one part to the other: it is added to Postgres2's
    directories and to Postgres1's exclusions, or removed from both; D-129
    moved tests/Feature/Inventory to Postgres2 this way. A run
    that names no suite takes the four suites of defaultTestSuite, as before
    the parts, so that no file is offered to two suites of one run, which
    PHPUnit refuses with a warning.

    The tests on PostgreSQL use the test database bantukasir_test (marker
    "test"), which database/setup/local.sh creates beside the local database,
    with the local roles of that script and no password (TASK-004): the
    application connects as the runtime role, the harness migrates and resets
    as the migration role (tests/Harness/TestDatabase.php). DB_URL is left
    empty: only the runtime connection reads it, and a URL would override its
    host, port and database, so every connection takes its target from the
    same values; the harness also refuses, before any write or reset, a
    connection that does not reach the test database (TASK-004 evidence
    section 10). Sessions and the cache use the array driver and store, except
    in the tests of the database cache store and of the database session
    driver (TASK-006); the copy of the security log on the container output
    goes to a memory stream.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         defaultTestSuite="Unit,Postgres,Concurrency,Network"
         colors="true"
         beStrictAboutOutputDuringTests="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         failOnEmptyTestSuite="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Postgres">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Postgres1">
            <directory>tests/Feature</directory>
            <exclude>tests/Feature/Access</exclude>
            <exclude>tests/Feature/Audit</exclude>
            <exclude>tests/Feature/Catalog</exclude>
            <exclude>tests/Feature/Inventory</exclude>
        </testsuite>
        <testsuite name="Postgres2">
            <directory>tests/Feature/Access</directory>
            <directory>tests/Feature/Audit</directory>
            <directory>tests/Feature/Catalog</directory>
            <directory>tests/Feature/Inventory</directory>
        </testsuite>
        <testsuite name="Concurrency">
            <directory>tests/Concurrency</directory>
        </testsuite>
        <testsuite name="Network">
            <directory>tests/Network</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="LOG_SECURITY_STREAM" value="php://memory" force="true"/>
        <env name="SESSION_SECURE_COOKIE" value="true" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="APP_ENVIRONMENT_NAME" value="test" force="true"/>
        <env name="DB_DATABASE" value="bantukasir_test" force="true"/>
        <env name="DB_USERNAME" value="bk_runtime" force="true"/>
        <env name="DB_MIGRATION_USERNAME" value="bk_migration" force="true"/>
        <env name="BACKUP_DB_USERNAME" value="bk_backup" force="true"/>
        <!--
            Laravel reads $_SERVER before $_ENV, and in the containers $_SERVER
            holds the container's own environment, so each value is also set
            there (TASK-004); the <env> entries reach child processes.
        -->
        <server name="APP_ENV" value="testing"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="CACHE_STORE" value="array"/>
        <server name="LOG_SECURITY_STREAM" value="php://memory"/>
        <server name="SESSION_SECURE_COOKIE" value="true"/>
        <server name="DB_CONNECTION" value="pgsql"/>
        <server name="DB_URL" value=""/>
        <server name="APP_ENVIRONMENT_NAME" value="test"/>
        <server name="DB_DATABASE" value="bantukasir_test"/>
        <server name="DB_USERNAME" value="bk_runtime"/>
        <server name="DB_MIGRATION_USERNAME" value="bk_migration"/>
        <server name="BACKUP_DB_USERNAME" value="bk_backup"/>
    </php>
</phpunit>
