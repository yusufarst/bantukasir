# Settings of BantuKasir (ENVIRONMENTS section 11), placeholders only. The real
# values live in the platform's configuration of each environment or in the
# operator's private store, never in the repository (SEC-SECRET-01, SEC-SECRET-03).
# Each process reads the settings of its role: "web" for the application
# container, "backup" for the backup container (ENVIRONMENTS section 6). The
# clock (UTC) and the scheduler's time zone (Asia/Jakarta) are fixed in
# config/app.php (ARC-50). The local environment of compose.yaml sets its own
# values for a local run.

# Both roles
APP_ENV=
# The environment's name, equal to its database's marker (ENVIRONMENTS ENV-04).
APP_ENVIRONMENT_NAME=
APP_DEBUG=false
APP_PROCESS_ROLE=
LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=

# Role web
APP_URL=
# The environment's host names, comma-separated; the host of APP_URL when empty
# (SECURITY_MODEL SEC-HDR-05; config/security.php).
APP_TRUSTED_HOSTS=
# The proxy hops in front of the application, addresses or CIDR ranges,
# comma-separated: the platform's proxy and Cloudflare's published ranges, set
# by the operator at gate TARGET (ENVIRONMENTS section 10); never a wildcard.
APP_TRUSTED_PROXIES=
# Strict-Transport-Security, turned on by the operator once HTTPS is verified on
# the target; includeSubDomains only when every subdomain is (SEC-HDR-02).
APP_HSTS=false
APP_HSTS_SUBDOMAINS=false
APP_KEY=
APP_PREVIOUS_KEYS=
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
HEARTBEAT_WEB_URL=
HEARTBEAT_RECONCILIATION_URL=

# Role backup
BACKUP_DB_USERNAME=
BACKUP_DB_PASSWORD=
BACKUP_STORE_ENDPOINT=
BACKUP_STORE_BUCKET=
BACKUP_STORE_KEY_ID=
BACKUP_STORE_KEY=
BACKUP_RECIPIENT=
HEARTBEAT_BACKUP_URL=

# Neither role: the migration database credential is given only to the
# migration job, at run time (ADR-011 item 7), as DB_MIGRATION_USERNAME and
# DB_MIGRATION_PASSWORD (config/database.php, connection pgsql_migration).
